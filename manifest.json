{
  "id": "dialog_base",
  "name": "Dialog Engine",
  "version": "0.1.0",
  "author": "ct",
  "description": "Dialog engine: the dialog box with portraits and answers, and the .scenario language in which every game of the collection tells its story.",
  "categories": ["engine", "library"],
  "sources": [
    "src/**/*.cs"
  ],
  "test_sources": [
    "tests/*.cs"
  ],
  "depends": [
    "shell2d_base>=0.1.0",
    "interactive_base>=0.1.0",
    "effects_base>=0.1.0",
    "time_base>=0.1.0",
    "ui_base>=0.1.0",
    "expressions_base>=0.1.0"
  ],
  "ui": [],
  "test_suites": [
    {
      "id": "autoplay",
      "activate": [
        "--choices=",
        "--timeout="
      ]
    },
    {
      "id": "gdscript",
      "activate": [
        "--itest=gdscript"
      ]
    },
    {
      "id": "doc_shots",
      "activate": [
        "--itest=doc_shots"
      ]
    }
  ]
}
